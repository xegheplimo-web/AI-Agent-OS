{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Agent OS",
  "identifier": "os.agent.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "http://127.0.0.1:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Agent OS — Control Plane",
        "url": "loading/index.html",
        "width": 1560,
        "height": 980,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:3000 ws://127.0.0.1:3000; frame-src 'self'",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "resources": {
      "../.next/standalone": "server/",
      "../.next/static": "server/.next/static/",
      "../public": "server/public/",
      "../src/worker": "server/src/worker/",
      "../src/services": "server/src/services/",
      "../src/db": "server/src/db/",
      "../src/lib": "server/src/lib/",
      "../drizzle": "server/drizzle/",
      "../package.json": "server/package.json",
      "../package-lock.json": "server/package-lock.json",
      "../drizzle.config.ts": "server/drizzle.config.ts"
    },
    "externalBin": ["binaries/node-sidecar"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
