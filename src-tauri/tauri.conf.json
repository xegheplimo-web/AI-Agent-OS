{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Agent OS",
  "identifier": "os.agent.ai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "http://127.0.0.1:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Agent OS — Control Plane",
        "url": "loading/index.html",
        "width": 1560,
        "height": 980,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "resources": {
      "../.next/standalone": "server/",
      "../.next/static": "server/.next/static/",
      "../public": "server/public/"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
